{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safsight:contracts:scan-request",
  "title": "SAFSight scan request",
  "type": "object",
  "properties": {
    "contractVersion": { "$ref": "urn:safsight:contracts:shared#/$defs/ContractVersion" },
    "requestId": { "type": "string", "minLength": 1 },
    "target": { "$ref": "urn:safsight:contracts:shared#/$defs/AssetTarget" }
  },
  "required": ["contractVersion", "requestId", "target"]
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safsight:contracts:scan-result",
  "title": "SAFSight scan result",
  "type": "object",
  "properties": {
    "contractVersion": { "$ref": "urn:safsight:contracts:shared#/$defs/ContractVersion" },
    "requestId": { "type": "string", "minLength": 1 },
    "status": { "$ref": "urn:safsight:contracts:shared#/$defs/ScanStatus" },
    "engine": { "$ref": "urn:safsight:contracts:shared#/$defs/EngineIdentity" },
    "findings": {
      "type": "array",
      "items": { "$ref": "urn:safsight:contracts:shared#/$defs/Finding" }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "error": { "$ref": "urn:safsight:contracts:shared#/$defs/ContractError" }
  },
  "required": ["contractVersion", "requestId", "status", "engine", "findings"]
}
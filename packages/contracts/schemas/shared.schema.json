{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safsight:contracts:shared",
  "title": "SAFSight shared contract definitions",
  "$defs": {
    "ContractVersion": {
      "const": "1.0.0",
      "description": "Version of the shared wire contract, independent of engine version."
    },
    "AssetTarget": {
      "type": "object",
      "description": "Canonical scan target; contains no persistence or organization identifiers.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["DOMAIN", "EMAIL", "WEBSITE"]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Must already be in the M03 canonical form for its type."
        }
      },
      "required": ["type", "value"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "DOMAIN" } }, "required": ["type"] },
          "then": {
            "properties": {
              "value": {
                "maxLength": 253,
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$",
                "description": "Lowercase ASCII/IDNA hostname form without URL separators."
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "EMAIL" } }, "required": ["type"] },
          "then": {
            "properties": {
              "value": {
                "maxLength": 254,
                "format": "email",
                "pattern": "^[^A-Z\\s]+$",
                "description": "Trimmed and lowercased email address."
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "WEBSITE" } }, "required": ["type"] },
          "then": {
            "properties": {
              "value": {
                "format": "uri",
                "pattern": "^https?://(?:[^/@?#]*@)?(?:\\[[0-9a-f:.]+\\]|[a-z0-9._~!$&'()*+,;=-]+)(?::[0-9]{1,5})?/\\S*$",
                "allOf": [
                  {
                    "if": { "pattern": "^http://" },
                    "then": {
                      "not": {
                        "pattern": "^http://(?:[^/@?#]*@)?(?:\\[[0-9a-f:.]+\\]|[a-z0-9._~!$&'()*+,;=-]+):0*80/"
                      }
                    }
                  },
                  {
                    "if": { "pattern": "^https://" },
                    "then": {
                      "not": {
                        "pattern": "^https://(?:[^/@?#]*@)?(?:\\[[0-9a-f:.]+\\]|[a-z0-9._~!$&'()*+,;=-]+):0*443/"
                      }
                    }
                  }
                ],
                "description": "Canonical absolute HTTP or HTTPS URL."
              }
            }
          }
        }
      ]
    },
    "ScanStatus": {
      "type": "string",
      "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]
    },
    "EngineIdentity": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "version"]
    },
    "Severity": {
      "type": "string",
      "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "data": {
          "type": "object",
          "description": "Optional engine-neutral structured evidence payload."
        }
      },
      "required": ["kind", "summary"]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "urn:safsight:contracts:shared#/$defs/Severity" },
        "description": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "urn:safsight:contracts:shared#/$defs/Evidence" }
        }
      },
      "required": ["code", "title", "severity"]
    },
    "ContractError": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "required": ["code", "message"]
    }
  }
}